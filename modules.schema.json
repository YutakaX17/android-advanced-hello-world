{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YutakaX17/android-advanced-hello-world/modules.schema.json",
  "title": "Advanced Hello World Android module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "distributionVersion", "featureContractVersion", "startFeatureId", "modules"],
  "properties": {
    "$schema": { "const": "./modules.schema.json" },
    "schemaVersion": { "const": 1 },
    "distributionVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "featureContractVersion": { "type": "integer", "minimum": 1 },
    "startFeatureId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "coordinate", "version"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "kind": { "enum": ["foundation", "domain", "feature"] },
          "coordinate": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_.-]+$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "factoryClass": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$" },
          "dependenciesClass": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "feature" } } },
            "then": { "required": ["factoryClass", "dependenciesClass"] },
            "else": {
              "allOf": [
                { "not": { "required": ["factoryClass"] } },
                { "not": { "required": ["dependenciesClass"] } }
              ]
            }
          }
        ]
      }
    }
  }
}
